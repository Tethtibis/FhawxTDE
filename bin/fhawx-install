#!/usr/bin/env bash
# ==============================================================================
# FHAWX-INSTALL // AUTOMATED DISK INSTALLER FOR FHAWX-DECK TDE
# Installs Live Debian 13 (Trixie) Fhawx-Deck system directly to local SSD/NVMe/HDD
# Target: Physical Laptops/Desktops/Chromebooks/VirtualBox
# Aesthetic: Monochromatic Burnt Orange (#CC5500)
# ==============================================================================

set -euo pipefail

# ANSI Color Palette
ORANGE='\033[38;2;204;85;0m'
AMBER='\033[38;2;255;140;0m'
RED='\033[0;31m'
GREEN='\033[0;32m'
GRAY='\033[0;90m'
NC='\033[0m'

clear
cat << "EOF"
  ███████╗██╗  ██╗ █████╗ ██╗    ██╗██╗  ██╗      ██╗███╗   ██╗███████╗████████╗ █████╗ ██╗     ██╗     
  ██╔════╝██║  ██║██╔══██╗██║    ██║╚██╗██╔╝      ██║████╗  ██║██╔════╝╚══██╔══╝██╔══██╗██║     ██║     
  █████╗  ███████║███████║██║ █╗ ██║ ╚███╔╝       ██║██╔██╗ ██║███████╗   ██║   ███████║██║     ██║     
  ██╔══╝  ██╔══██║██╔══██║██║███╗██║ ██╔██╗  ██   ██║██║╚██╗██║╚════██║   ██║   ██╔══██║██║     ██║     
  ██║     ██║  ██║██║  ██║╚███╔███╔╝██╔╝ ██╗  ╚█████╔╝██║ ╚████║███████║   ██║   ██║  ██║███████╗███████╗
  ╚═╝     ╚═╝  ╚═╝╚═╝  ╚═╝ ╚══╝╚══╝ ╚═╝  ╚═╝   ╚════╝ ╚═╝  ╚═══╝╚══════╝   ╚═╝   ╚═╝  ╚═╝╚══════╝╚══════╝
EOF
echo -e "${ORANGE}================================================================================${NC}"
echo -e "${AMBER}  FHAWX-DECK TDE // UNIVERSAL SYSTEM DISK INSTALLER (DEBIAN 13 TRIXIE)${NC}"
echo -e "${ORANGE}================================================================================${NC}\n"

# Verify Root
if [ "$(id -u)" -ne 0 ]; then
    echo -e "${RED}[-] Error: This installer must be run as root (use: sudo fhawx-install).${NC}" >&2
    exit 1
fi

# Detect Boot Mode
if [ -d /sys/firmware/efi ]; then
    BOOT_MODE="UEFI"
    echo -e "${GREEN}[+] Boot Mode Detected: UEFI (64-bit)${NC}"
else
    BOOT_MODE="BIOS"
    echo -e "${AMBER}[+] Boot Mode Detected: Legacy BIOS / MBR${NC}"
fi

# Detect Live Root and exclude installation media
LIVE_MEDIA=""
if [ -d /run/live/medium ]; then
    LIVE_MEDIA=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null || true)
fi

echo -e "\n${AMBER}[*] Scanning available target drives...${NC}\n"

# Enumerate block devices (disks only, exclude loop, sr, ram, zram)
mapfile -t ALL_DISKS < <(lsblk -d -p -n -o NAME,SIZE,MODEL,TRAN | grep -v -E "loop|sr[0-9]|zram|ram")

VALID_DISKS=()
for disk_entry in "${ALL_DISKS[@]}"; do
    dev_name=$(echo "$disk_entry" | awk '{print $1}')
    # Skip if disk is part of live media
    if [ -n "$LIVE_MEDIA" ] && [[ "$LIVE_MEDIA" == "$dev_name"* ]]; then
        continue
    fi
    VALID_DISKS+=("$disk_entry")
done

if [ ${#VALID_DISKS[@]} -eq 0 ]; then
    echo -e "${RED}[-] Error: No target installation disks found.${NC}"
    echo -e "${GRAY}    (If running inside a VM, ensure a virtual hard drive is attached).${NC}"
    exit 1
fi

echo -e "${ORANGE}Available Disks:${NC}"
for i in "${!VALID_DISKS[@]}"; do
    printf "  ${AMBER}[%d]${NC} %s\n" "$((i+1))" "${VALID_DISKS[$i]}"
done
echo "  [0] Cancel / Exit"

echo ""
read -r -p "Select target disk for installation [1-${#VALID_DISKS[@]}]: " DISK_IDX

if [[ "$DISK_IDX" == "0" ]] || [[ -z "$DISK_IDX" ]]; then
    echo "Installation cancelled."
    exit 0
fi

if ! [[ "$DISK_IDX" =~ ^[0-9]+$ ]] || [ "$DISK_IDX" -lt 1 ] || [ "$DISK_IDX" -gt ${#VALID_DISKS[@]} ]; then
    echo -e "${RED}[-] Invalid selection.${NC}"
    exit 1
fi

SELECTED_LINE="${VALID_DISKS[$((DISK_IDX-1))]}"
TARGET_DEV=$(echo "$SELECTED_LINE" | awk '{print $1}')
TARGET_SIZE=$(echo "$SELECTED_LINE" | awk '{print $2}')
TARGET_MODEL=$(echo "$SELECTED_LINE" | awk '{$1=$2=""; print $0}' | sed 's/^[ \t]*//')

echo -e "\n${RED}================================================================================${NC}"
echo -e "${RED}  CRITICAL WARNING: ALL DATA ON ${TARGET_DEV} WILL BE COMPLETELY DESTROYED!${NC}"
echo -e "  Target Device: ${TARGET_DEV} (${TARGET_SIZE} - ${TARGET_MODEL})"
echo -e "  Boot Mode:     ${BOOT_MODE}"
echo -e "${RED}================================================================================${NC}\n"

read -r -p "Type 'YES' in all caps to confirm disk wipe and begin installation: " CONFIRM
if [ "$CONFIRM" != "YES" ]; then
    echo "Confirmation did not match 'YES'. Installation aborted."
    exit 0
fi

echo -e "\n${AMBER}[1/7] Unmounting existing partitions on ${TARGET_DEV}...${NC}"
for p in "${TARGET_DEV}"* "${TARGET_DEV}"p*; do
    if [ -b "$p" ]; then
        umount -f "$p" 2>/dev/null || true
        swapoff "$p" 2>/dev/null || true
    fi
done

echo -e "${AMBER}[2/7] Creating fresh GPT partition table...${NC}"
dd if=/dev/zero of="${TARGET_DEV}" bs=512 count=2048 status=none conv=notrunc || true
parted -s "${TARGET_DEV}" mklabel gpt

# Partition naming convention: nvme0n1 -> nvme0n1p1, sda -> sda1
P_PREFIX="${TARGET_DEV}"
if [[ "${TARGET_DEV}" =~ [0-9]$ ]]; then
    P_PREFIX="${TARGET_DEV}p"
fi

if [ "$BOOT_MODE" = "UEFI" ]; then
    # Partition 1: EFI System Partition (512MB)
    parted -s "${TARGET_DEV}" mkpart '"ESP"' fat32 1MiB 513MiB
    parted -s "${TARGET_DEV}" set 1 esp on
    # Partition 2: Root Filesystem (Rest of disk)
    parted -s "${TARGET_DEV}" mkpart '"FHAWX_ROOT"' ext4 513MiB 100%

    PART_EFI="${P_PREFIX}1"
    PART_ROOT="${P_PREFIX}2"
else
    # BIOS Boot partition for GRUB on GPT (1MB)
    parted -s "${TARGET_DEV}" mkpart '"BIOSBOOT"' 1MiB 2MiB
    parted -s "${TARGET_DEV}" set 1 bios_grub on
    # Partition 2: Root Filesystem (Rest of disk)
    parted -s "${TARGET_DEV}" mkpart '"FHAWX_ROOT"' ext4 2MiB 100%

    PART_EFI=""
    PART_ROOT="${P_PREFIX}2"
fi

udevadm settle
sleep 1

echo -e "${AMBER}[3/7] Formatting partitions...${NC}"
if [ -n "$PART_EFI" ]; then
    echo "  -> Formatting EFI System Partition (${PART_EFI})..."
    mkfs.vfat -F32 -n "EFI" "${PART_EFI}" >/dev/null
fi

echo "  -> Formatting Root ext4 Partition (${PART_ROOT})..."
mkfs.ext4 -F -q -L "FHAWX-ROOT" "${PART_ROOT}"

echo -e "${AMBER}[4/7] Mounting target filesystem...${NC}"
MOUNT_DIR="/mnt/fhawx_target"
mkdir -p "${MOUNT_DIR}"
mount "${PART_ROOT}" "${MOUNT_DIR}"

if [ -n "$PART_EFI" ]; then
    mkdir -p "${MOUNT_DIR}/boot/efi"
    mount "${PART_EFI}" "${MOUNT_DIR}/boot/efi"
fi

echo -e "${AMBER}[5/7] Copying Fhawx-Deck system to target disk (this will take 2-4 minutes)...${NC}"
rsync -aAXH --info=progress2 \
    --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found","/swapfile"} \
    / "${MOUNT_DIR}/"

# Generate pristine /etc/fstab with UUIDs
echo -e "${AMBER}[6/7] Configuring bootloader and system parameters...${NC}"
ROOT_UUID=$(blkid -s UUID -o value "${PART_ROOT}")
cat << EOF > "${MOUNT_DIR}/etc/fstab"
# /etc/fstab: static file system information
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
UUID=${ROOT_UUID}  /               ext4    errors=remount-ro 0       1
EOF

if [ -n "$PART_EFI" ]; then
    EFI_UUID=$(blkid -s UUID -o value "${PART_EFI}")
    echo "UUID=${EFI_UUID}  /boot/efi       vfat    umask=0077      0       2" >> "${MOUNT_DIR}/etc/fstab"
fi

# Ensure hostname is set
echo "fhawx-deck" > "${MOUNT_DIR}/etc/hostname"
cat << EOF > "${MOUNT_DIR}/etc/hosts"
127.0.0.1   localhost
127.0.1.1   fhawx-deck

# The following lines are desirable for IPv6 capable hosts
::1     ip6-localhost ip6-loopback
fe00::0 ip6-localnet
ff00::0 ip6-mcastprefix
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF

# Bind mounts for chroot
for fs in /dev /dev/pts /proc /sys /run; do
    mount --bind "$fs" "${MOUNT_DIR}$fs"
done

# Purge live packages from installed system so it boots as standard OS
chroot "${MOUNT_DIR}" apt-get purge -y live-boot live-config live-config-systemd >/dev/null 2>&1 || true

# Rebuild initramfs for newly installed disk storage
echo "  -> Updating target initramfs..."
chroot "${MOUNT_DIR}" update-initramfs -u -k all >/dev/null 2>&1 || true

# Install GRUB Bootloader
echo "  -> Installing GRUB bootloader (${BOOT_MODE})..."
if [ "$BOOT_MODE" = "UEFI" ]; then
    chroot "${MOUNT_DIR}" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Debian --recheck >/dev/null 2>&1 || true
    # Also install removable fallback EFI binary
    chroot "${MOUNT_DIR}" grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable >/dev/null 2>&1 || true
else
    chroot "${MOUNT_DIR}" grub-install --target=i386-pc "${TARGET_DEV}" >/dev/null 2>&1 || true
fi
chroot "${MOUNT_DIR}" update-grub >/dev/null 2>&1 || true

# Clean up mounts
echo -e "${AMBER}[7/7] Finalizing system and unmounting...${NC}"
umount -R "${MOUNT_DIR}/dev" 2>/dev/null || true
umount -R "${MOUNT_DIR}/proc" 2>/dev/null || true
umount -R "${MOUNT_DIR}/sys" 2>/dev/null || true
umount -R "${MOUNT_DIR}/run" 2>/dev/null || true
if [ -n "$PART_EFI" ]; then
    umount -f "${MOUNT_DIR}/boot/efi" 2>/dev/null || true
fi
umount -f "${MOUNT_DIR}" 2>/dev/null || true

echo -e "\n${GREEN}================================================================================${NC}"
echo -e "${GREEN}  [✓] FHAWX-DECK TDE INSTALLATION COMPLETED SUCCESSFULLY!${NC}"
echo -e "${GREEN}================================================================================${NC}"
echo -e "${ORANGE}Target Disk:${NC} ${TARGET_DEV}"
echo -e "${ORANGE}Default User:${NC} fhawx  ${GRAY}(password: fhawx)${NC}"
echo -e "${ORANGE}Root Access:${NC}  sudo authorized"
echo -e "${AMBER}You can now reboot your computer and remove the installation USB.${NC}\n"

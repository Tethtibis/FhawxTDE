#!/usr/bin/env bash
# ==============================================================================
# FHAWX-KILL-PANE // PROTECTED PANE TERMINATOR
# Triggered by: Alt + K or Command Palette
# Aesthetic: Burnt Orange (#CC5500)
# Failsafe: Default cursor is locked to [ Cancel ] to prevent typing accidents.
# ==============================================================================

set -euo pipefail

TMUX_CMD=(tmux -L fhawx)
PANE_COUNT=$("${TMUX_CMD[@]}" list-panes | wc -l)

# If only 1 pane in the window, check if user really wants to close the last pane
if [ "$PANE_COUNT" -le 1 ]; then
    HEADER="⚠️ Close the only pane on this workspace? (Will reset to clean shell)"
else
    HEADER="⚠️ Kill active pane and restore full-screen?"
fi

# Interactive confirmation with cursor default sitting on CANCEL
CONFIRM="Cancel"

if command -v gum >/dev/null 2>&1; then
    CONFIRM=$(gum choose \
        --header.foreground "#FF8C00" \
        --header "$HEADER" \
        --cursor.foreground "#CC5500" \
        --item.foreground "#888888" \
        --selected="1. [ Cancel ] (Keep working)" \
        "1. [ Cancel ] (Keep working)" \
        "2. [ KILL PANE ] (Terminate process)")
elif command -v dialog >/dev/null 2>&1; then
    if dialog --defaultno --title " FHAWXTDE TERMINATOR " --yesno "$HEADER" 7 50; then
        CONFIRM="KILL"
    else
        CONFIRM="Cancel"
    fi
    clear
else
    echo "$HEADER"
    read -r -p "Type 'yes' to kill active pane: " answer
    [ "$answer" = "yes" ] && CONFIRM="KILL"
fi

case "$CONFIRM" in
    *"KILL"*|*"Kill"*)
        if [ "$PANE_COUNT" -gt 1 ]; then
            "${TMUX_CMD[@]}" kill-pane
        else
            # If last pane, respawn a pristine bash shell rather than killing the window
            "${TMUX_CMD[@]}" respawn-pane -k "bash"
        fi
        ;;
    *)
        exit 0
        ;;
esac

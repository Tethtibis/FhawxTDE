#!/usr/bin/env bash
# ==============================================================================
# TDE // SHORT ALIAS FOR FHAWXTDE ("DOS SHELL" LAUNCHER)
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -x "$SCRIPT_DIR/fhawx" ]; then
    exec "$SCRIPT_DIR/fhawx" "$@"
elif command -v fhawx >/dev/null 2>&1; then
    exec fhawx "$@"
else
    exec "$HOME/.local/bin/fhawx" "$@"
fi

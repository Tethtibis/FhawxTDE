#!/usr/bin/env bash
# ==============================================================================
# FHAWX-WORKSPACE-TOGGLE // INDESTRUCTIBLE 2-WORKSPACE FLIPPER
# Triggered by: Alt + W or Command Palette
# Resilience: Even if a workspace was closed by Ctrl+C or 'exit', Alt+W
#             automatically respawns it on demand.
# ==============================================================================

set -euo pipefail

cur_win=$(tmux display-message -p "#{window_index}" 2>/dev/null || echo "1")

if [ "$cur_win" -eq 1 ]; then
    # On Workspace 1 -> flip to Workspace 2
    if ! tmux select-window -t 2 2>/dev/null; then
        # Workspace 2 was closed or doesn't exist -> resurrect it
        tmux new-window -t 2 -n "Ops" "bash"
    fi
else
    # On Workspace 2 -> flip to Workspace 1
    if ! tmux select-window -t 1 2>/dev/null; then
        # Workspace 1 was closed or doesn't exist -> resurrect it
        tmux new-window -t 1 -n "Main" "bash"
    fi
fi

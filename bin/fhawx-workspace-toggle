#!/usr/bin/env bash
# ==============================================================================
# FHAWX-WORKSPACE-TOGGLE // INDESTRUCTIBLE 2-WORKSPACE FLIPPER
# Triggered by: Alt + W or Command Palette
# Resilience: Even if a workspace was closed by Ctrl+C or 'exit', Alt+W
#             automatically respawns it on demand.
# ==============================================================================

set -euo pipefail

TMUX_CMD=(tmux -L fhawx)
cur_win=$("${TMUX_CMD[@]}" display-message -p "#{window_index}" 2>/dev/null || echo "1")

if [ "$cur_win" -eq 1 ]; then
    # On Workspace 1 -> flip to Workspace 2
    if ! "${TMUX_CMD[@]}" select-window -t 2 2>/dev/null; then
        "${TMUX_CMD[@]}" new-window -t 2 -n "Ops" "bash"
    fi
else
    # On Workspace 2 -> flip to Workspace 1
    if ! "${TMUX_CMD[@]}" select-window -t 1 2>/dev/null; then
        "${TMUX_CMD[@]}" new-window -t 1 -n "Main" "bash"
    fi
fi

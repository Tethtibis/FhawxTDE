#!/usr/bin/env bash
# ==============================================================================
# FHAWX-SESSION-INIT // BACKWARD-COMPATIBLE ENTRYPOINT WRAPPER
# Delegates directly to the unified 'fhawx' launcher.
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -x "$SCRIPT_DIR/fhawx" ]; then
    exec "$SCRIPT_DIR/fhawx" "$@"
elif command -v fhawx >/dev/null 2>&1; then
    exec fhawx "$@"
else
    exec "$HOME/.local/bin/fhawx" "$@"
fi

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/fhawx_logo.txt",
    "type": "file-raw",
    "position": "top",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "keys": "38;2;255;140;0",
      "title": "38;2;204;85;0"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS      ",
      "format": "{3} ({12})"
    },
    {
      "type": "host",
      "key": "Machine "
    },
    {
      "type": "kernel",
      "key": "Kernel  "
    },
    {
      "type": "uptime",
      "key": "Uptime  "
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "shell",
      "key": "Shell   "
    },
    {
      "type": "wm",
      "key": "Session "
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "cpu",
      "key": "CPU     "
    },
    {
      "type": "memory",
      "key": "Memory  "
    },
    {
      "type": "disk",
      "key": "Storage "
    },
    "break",
    "colors"
  ]
}

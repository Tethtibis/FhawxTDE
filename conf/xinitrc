#!/bin/sh
# ==============================================================================
# FHAWXTDE // MICRO-X11 KIOSK SESSION (~38 MiB RAM)
# Optional bare-metal netbook mode (--kiosk). Launches full-screen terminal into fhawx.
# ==============================================================================

export NO_AT_SPI=1

xsetroot -solid "#000000"

if command -v unclutter >/dev/null 2>&1; then
    unclutter -idle 3 -root &
fi

if command -v matchbox-window-manager >/dev/null 2>&1; then
    matchbox-window-manager -use_titlebar no &
fi

if command -v xfce4-terminal >/dev/null 2>&1; then
    exec xfce4-terminal \
        --disable-server \
        --hide-menubar \
        --hide-borders \
        --hide-toolbar \
        --fullscreen \
        --title="FhawxTDE" \
        -e "$HOME/.local/bin/fhawx"
else
    exec xterm -fullscreen -e "$HOME/.local/bin/fhawx"
fi
